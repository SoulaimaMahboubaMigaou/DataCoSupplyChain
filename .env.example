# Seeds the administrator account on first start. After that, the email and
# password are managed from the "My Profile" page and stored (hashed) in
# storage/admin_account.json.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars-1

# Required, 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Absolute path to the processed dataset used by tracking and predictions.
DATASET_PATH=./data/processed/DataCo_featured.csv

# Comma-separated list of origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Set to 0 to disable destination geocoding (cached cities still resolve).
GEOCODING_ENABLED=1
